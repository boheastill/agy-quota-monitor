{
  "command": "node",
  "args": ["main.mjs"],
  "restart_policy": "always",
  "display_name": "Quota Monitor",
  "description": "Live view of global model quota pools (5h & weekly), reset countdowns, and deterministic per-session token workload.",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": false
  },
  "ui_config": {
    "display_name": "Quota",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "Quota"
      }
    ]
  }
}
